# Copia este archivo como ".env" (NO lo subas a GitHub) y reemplaza los valores.
# Generar secretos en Linux/Mac:  openssl rand -base64 48

# Secreto JWT compartido por los 7 microservicios (Base64, 48+ bytes)
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_BASE64

# Origen del frontend permitido por CORS (IP pública o dominio de EC2)
APP_CORS_ALLOWED_ORIGIN=http://IP_PUBLICA_DE_EC2

# Clave compartida solo entre ms-productos y ms-pedidos (stock). Distinta del JWT_SECRET
CLAVE_INTERNA=REEMPLAZAR

# Claves de MariaDB (una por usuario; todas distintas)
DB_ROOT_PASSWORD=REEMPLAZAR
AUTH_DB_PASSWORD=REEMPLAZAR
SERVICIOS_DB_PASSWORD=REEMPLAZAR
MASCOTAS_DB_PASSWORD=REEMPLAZAR
CITAS_DB_PASSWORD=REEMPLAZAR
FICHAS_DB_PASSWORD=REEMPLAZAR
PRODUCTOS_DB_PASSWORD=REEMPLAZAR
PEDIDOS_DB_PASSWORD=REEMPLAZAR

# Cuentas iniciales del personal (se crean al primer arranque de ms-auth)
RECEPCION_CORREO=recepcion@veterinariasanmarcos.cl
RECEPCION_PASSWORD=REEMPLAZAR
ADMIN_CORREO=admin@veterinariasanmarcos.cl
ADMIN_PASSWORD=REEMPLAZAR

# Ruta del proyecto React (por defecto una carpeta hermana)
# FRONTEND_DIR=../VeterinariaSanMarcosReact

# Puertos de Swagger (8082-8088): 0.0.0.0 los publica en internet; 127.0.0.1 los deja solo en la propia maquina
SWAGGER_BIND=127.0.0.1
