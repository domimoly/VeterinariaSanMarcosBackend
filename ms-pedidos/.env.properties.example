# Copia este archivo como .env.properties y reemplaza el valor.
# Genera uno nuevo (Base64, 48+ bytes), por ejemplo en PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }))
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_BASE64
# Clave compartida entre ms-productos y ms-pedidos (cualquier texto largo y aleatorio)
CLAVE_INTERNA=REEMPLAZAR_POR_UNA_CLAVE_LARGA
